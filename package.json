{
  "name": "money-poly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Money Poly (머니폴리) — pass-and-play property trading board game for one tablet",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "fx:atlas": "node scripts/fx/bake.mjs && node scripts/fx/bake-money.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sim": "tsx scripts/balance.ts",
    "fun": "tsx scripts/fun.ts",
    "skill": "tsx scripts/skill.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "release:check": "node scripts/release-check.mjs",
    "perf": "vite build && node scripts/perf.mjs",
    "perf:render": "vite build && node scripts/perf-render.mjs",
    "perf:frames": "vite build && node scripts/perf-frames.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "maxrects-packer": "^2.7.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2"
  }
}
